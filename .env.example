# URL pública del sitio, sin barra final. Se usa para canonical, Open Graph, sitemap y robots.
# En local: http://localhost:3000. En producción: el dominio del cliente.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "true" solo en producción, cuando el sitio esté publicado en el dominio final.
# Con cualquier otro valor el sitio sale con noindex y robots.txt bloquea a los buscadores.
NEXT_PUBLIC_SITE_INDEXABLE=false
